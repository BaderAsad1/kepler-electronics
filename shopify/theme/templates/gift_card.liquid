{% layout none %}<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex"><title>{{ 'gift_card.title' | t }} — {{ shop.name | escape }}</title>{{ 'kepler.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body><main class="container section gift-card"><h1>{{ 'gift_card.title' | t }}</h1><p>{{ shop.name | escape }}</p><h2>{{ gift_card.balance | money_with_currency }}</h2>{% if gift_card.expired %}<p>{{ 'gift_card.expired' | t }}</p>{% endif %}{% unless gift_card.enabled %}<p>{{ 'gift_card.disabled' | t }}</p>{% endunless %}<p>{{ 'gift_card.code' | t }}</p><p class="gift-card-code">{{ gift_card.code | format_code }}</p>{% if gift_card.expires_on %}<p>{{ 'gift_card.expires' | t }} {{ gift_card.expires_on | date: format: 'date' }}</p>{% endif %}<a class="button" href="{{ shop.url }}">{{ 'general.explore_products' | t }}</a>{% if gift_card.pass_url %}<a class="button secondary" href="{{ gift_card.pass_url }}">{{ 'gift_card.wallet' | t }}</a>{% endif %}</main></body></html>
