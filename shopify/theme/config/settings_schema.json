        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#164B49"
      },
      {
        "type": "select",
        "id": "heading_style",
        "label": "Heading font",
        "options": [
          {
            "value": "sans",
            "label": "Modern sans serif"
          },
          {
            "value": "serif",
            "label": "Editorial serif"
          }
        ],
        "default": "sans"
      },
      {
        "type": "range",
        "id": "content_width",
        "label": "Content width",
        "min": 1100,
        "max": 1500,
        "step": 20,
        "default": 1320
      }
    ]
  },
  {
    "name": "Store and project enquiries",
    "settings": [
      {
        "type": "paragraph",
