<section class="container section"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'general.all_products' | t }}{% render 'icon', name: 'arrow' %}</a></div><div class="product-grid">{% if section.settings.products != blank %}{% for product in section.settings.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% elsif section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% elsif request.design_mode %}{% for i in (1..4) %}<article class="product-card">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}<h3>{{ 'general.select_products' | t }}</h3></article>{% endfor %}{% else %}<p>{{ 'general.explore_catalog' | t }}</p>{% endif %}</div></section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE BUILDING BLOCKS OF INTELLIGENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Precise technology. Real possibilities."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Selected products",
      "limit": 8
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
