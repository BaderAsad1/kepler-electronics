<section class="catalog-search"><div class="container catalog-search-layout"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p class="caption">{{ section.settings.text | escape }}</p></div><form action="{{ routes.search_url }}" method="get" role="search"><label for="CatalogSearch-{{ section.id }}">{{ 'search.label' | t }}</label><div class="search-form"><input id="CatalogSearch-{{ section.id }}" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" maxlength="200" required><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"><button class="button" type="submit">{{ 'search.submit' | t }}{% render 'icon', name: 'search' %}</button></div></form></div></section>
{% schema %}
{
  "name": "Catalogue search",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KNOW THE MODEL? START HERE." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the exact technology." },
    { "type": "text", "id": "text", "label": "Help text", "default": "Search by model number, product or brand. Then request pricing for your specification." }
  ],
  "presets": [{ "name": "Catalogue search" }]
}
{% endschema %}
