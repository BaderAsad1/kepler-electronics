<article class="container section article"><p class="eyebrow"><a href="{{ blog.url }}">{{ blog.title | escape }}</a></p><h1>{{ article.title | escape }}</h1><p class="caption">{{ article.published_at | date: format: 'date' }}{% if section.settings.show_author %} · {{ article.author | escape }}{% endif %}</p>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 900px, 100vw', loading: 'eager' }}{% endif %}<div class="rte">{{ article.content }}</div>
{% if blog.comments_enabled? %}<section class="article-comments"><h2>{{ 'blog.comments' | t }}</h2>{% paginate article.comments by 20 %}{% for comment in article.comments %}<article><p>{{ comment.author | escape }} · {{ comment.created_at | date: format: 'date' }}</p><div class="rte">{{ comment.content }}</div></article>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}
{% form 'new_comment', article %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'blog.comment_success' | t }}</p>{% endif %}<label for="CommentAuthor">{{ 'contact.name' | t }}</label><input id="CommentAuthor" name="comment[author]" autocomplete="name" value="{{ form.author | escape }}" required><label for="CommentEmail">{{ 'contact.email' | t }}</label><input id="CommentEmail" type="email" name="comment[email]" autocomplete="email" value="{{ form.email | escape }}" required><label for="CommentBody">{{ 'contact.message' | t }}</label><textarea id="CommentBody" name="comment[body]" required>{{ form.body | escape }}</textarea><button type="submit" class="button">{{ 'blog.comment_submit' | t }}</button>{% endform %}</section>{% endif %}</article><script type="application/ld+json">{{ article | structured_data }}</script>
{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    }
  ]
}
{% endschema %}
