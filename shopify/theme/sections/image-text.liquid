<section class="image-text{% if section.settings.dark %} dark{% endif %}{% if section.settings.reverse %} reverse{% endif %}"><div class="editorial-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy' }}{% else %}<img src="{{ 'architectural-lighting.webp' | asset_url }}" width="1672" height="941" alt="{{ 'images.lighting' | t }}" loading="lazy">{% endif %}{% if section.settings.credit != blank %}<span class="image-credit">{{ section.settings.credit | escape }}</span>{% endif %}</div><div class="editorial-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}{% render 'icon', name: 'arrow' %}</a>{% endif %}</div></section>
{% schema %}
{
  "name": "Image with story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ONE SPACE. ONE CONNECTED EXPERIENCE."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technology you feel. Not technology you see."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The right light. A comfortable room. A welcome home. Bring lighting, climate, curtains and access into one considered system.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Discover connected control"
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Image credit",
      "default": "Illustrative architectural concept"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Image on the right",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Image with story"
    }
  ]
}
{% endschema %}
