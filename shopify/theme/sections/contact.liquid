<section class="container section contact-layout"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ page.title | default: section.settings.heading | escape }}</h1><div class="rte">{{ section.settings.text }}{{ page.content }}</div><address>{{ settings.address | escape }}<br><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone | escape }}</a><br><a href="mailto:{{ settings.email | escape }}">{{ settings.email | escape }}</a></address></div>
<div>{% assign contact_id = 'Contact-' | append: section.id %}{% form 'contact', id: contact_id %}
{% if form.posted_successfully? %}<p class="success" tabindex="-1" role="status" data-contact-success>{{ 'contact.success' | t }}</p>{% endif %}
{% if form.errors %}<div class="form-error" tabindex="-1" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
<label for="Name-{{ section.id }}">{{ 'contact.name' | t }}</label><input id="Name-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required maxlength="150">
<label for="Email-{{ section.id }}">{{ 'contact.email' | t }}</label><input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required maxlength="254"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
<label for="Phone-{{ section.id }}">{{ 'contact.phone' | t }}</label><input id="Phone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}" maxlength="60">
<label for="Project-{{ section.id }}">{{ 'contact.project' | t }}</label><input id="Project-{{ section.id }}" type="text" name="contact[Project]" maxlength="200">
{% if section.settings.quote %}<div data-quote-list></div><label for="Quote-{{ section.id }}">{{ 'quote.specification' | t }}</label><textarea id="Quote-{{ section.id }}" name="contact[Project list]" rows="6" maxlength="15000" data-quote-summary>{{ form['Project list'] | escape }}</textarea><p class="caption">{{ 'quote.local_notice' | t }}</p>{% endif %}
<label for="Message-{{ section.id }}">{{ 'contact.message' | t }}</label><textarea id="Message-{{ section.id }}" name="contact[body]" rows="6" required maxlength="15000">{{ form.body | escape }}</textarea>
{% if shop.privacy_policy != blank %}<p class="caption">{{ 'contact.privacy' | t }} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></p>{% endif %}<button class="button full" type="submit">{{ 'contact.send' | t }}{% render 'icon', name: 'diagonal' %}</button>{% endform %}</div></section>
{% schema %}
{
  "name": "Contact or project quote",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MAKE THE CONNECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell us what your space needs to do."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>A home, a hotel, a commercial building. Start a conversation with our Dubai team.</p>"
    },
    {
      "type": "checkbox",
      "id": "quote",
      "label": "Include project list",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Contact or project quote"
    }
  ]
}
{% endschema %}
