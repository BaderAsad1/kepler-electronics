<section class="hero" aria-labelledby="HeroTitle-{{ section.id }}">
<picture>{% if section.settings.image != blank %}{% if section.settings.mobile_image != blank %}<source media="(max-width: 600px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '768, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'hero-image' }}{% else %}<source media="(max-width: 600px)" srcset="{{ 'dubai-smart-villa-mobile-768.webp' | asset_url }}"><img src="{{ 'dubai-smart-villa-hero.webp' | asset_url }}" srcset="{{ 'dubai-smart-villa-hero-768.webp' | asset_url }} 768w, {{ 'dubai-smart-villa-hero.webp' | asset_url }} 1672w" sizes="100vw" width="1672" height="941" alt="{{ 'images.villa' | t }}" fetchpriority="high" class="hero-image">{% endif %}</picture>
<div class="hero-shade"></div><div class="container hero-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 id="HeroTitle-{{ section.id }}">{{ section.settings.heading | escape }}<br><em>{{ section.settings.heading_emphasis | escape }}</em></h1><p class="hero-description">{{ section.settings.description | escape }}</p><div class="button-row"><a class="button light" href="{{ section.settings.primary_link | default: settings.contact_page.url | default: '/pages/contact' }}">{{ section.settings.primary_label | escape }}{% render 'icon', name: 'diagonal' %}</a><a class="hero-secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label | escape }}{% render 'icon', name: 'arrow' %}</a></div><div class="hero-bottom"><span><i class="status-dot"></i>{{ section.settings.location | escape }}</span><span>01 / {{ section.settings.scene | escape }}</span></div></div>
{% if section.settings.credit != blank %}<span class="image-credit">{{ section.settings.credit | escape }}</span>{% endif %}</section>
{% schema %}
{
  "name": "Architectural hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SMART BUILDINGS. CONNECTED LIVING."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Intelligence."
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Emphasis",
      "default": "Built in."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Smart building and home automation, from lighting and climate to access and control. Technology that makes your space work beautifully."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Discuss your project"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Explore products"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "YOUR DUBAI TECHNOLOGY PARTNER"
    },
    {
      "type": "text",
      "id": "scene",
      "label": "Scene",
      "default": "CONNECTED LIVING"
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Image credit",
      "default": "Illustrative architectural concept"
    }
  ],
  "presets": [
    {
      "name": "Architectural hero"
    }
  ]
}
{% endschema %}
