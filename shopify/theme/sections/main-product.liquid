{% liquid
 assign current_variant = product.selected_or_first_available_variant
 assign featured_media = current_variant.featured_media | default: product.featured_media
 assign form_id = 'ProductForm-' | append: section.id
 assign quote_url = settings.quote_page.url | default: '/pages/project-quote'
%}
{% capture mode %}{% render 'commerce-mode', product: product %}{% endcapture %}
<section class="container section product-section" data-product-section="{{ section.id }}" data-product-url="{{ product.url }}" data-variant-id="{{ current_variant.id }}">
<nav class="breadcrumbs" aria-label="{{ 'accessibility.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><a href="{{ collection.url | default: routes.all_products_collection_url }}">{% if collection %}{{ collection.title | escape }}{% else %}{{ 'general.products' | t }}{% endif %}</a><span>/</span><span>{{ product.title | escape }}</span></nav>
<div class="product-layout"><div class="product-summary"><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1>{% if current_variant.sku != blank %}<p class="model">{{ 'product.model' | t }} <span data-product-sku>{{ current_variant.sku | escape }}</span></p>{% endif %}
<div data-product-price>{% render 'price', product: product, variant: current_variant %}</div>
{% unless product.has_only_default_variant %}<div class="enhanced-options" data-enhanced-options hidden>{% for option in product.options_with_values %}<label for="Option-{{ section.id }}-{{ forloop.index }}">{{ option.name | escape }}</label><select id="Option-{{ section.id }}-{{ forloop.index }}" data-option-value>{% for value in option.values %}<option value="{{ value.id }}"{% if value.selected %} selected{% endif %}>{{ value.name | escape }}</option>{% endfor %}</select>{% endfor %}</div>{% endunless %}
<noscript>{% unless product.has_only_default_variant %}<form action="{{ product.url }}" method="get"><label for="NoJSVariant-{{ section.id }}">{{ 'product.variant' | t }}</label><select id="NoJSVariant-{{ section.id }}" name="variant">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}>{{ variant.title | escape }}</option>{% endfor %}</select><button class="button secondary" type="submit">{{ 'general.update' | t }}</button></form>{% endunless %}</noscript>
{% if mode != 'buy' %}{% render 'quote-action', product: product, class: 'full', request_pricing: true %}<p class="caption">{{ 'product.quote_help' | t }}</p>{% endif %}
</div>
<div class="product-gallery">{% if featured_media != blank %}<div class="media-feature" id="Media-{{ section.id }}">{% render 'product-media', media: featured_media, loading: 'eager' %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}
{% if product.media.size > 1 %}<div class="media-thumbnails">{% for media in product.media %}<a href="#Gallery-{{ section.id }}-{{ media.id }}" data-media-select aria-label="{{ 'product.media_number' | t: number: forloop.index }}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', sizes: '90px' }}</a>{% endfor %}</div><details class="more-media"><summary>{{ 'product.more_media' | t }}</summary><div class="media-grid">{% for media in product.media %}<div id="Gallery-{{ section.id }}-{{ media.id }}">{% render 'product-media', media: media, loading: 'lazy' %}</div>{% endfor %}</div></details>{% endif %}</div>
<div class="product-information">{% form 'product', product, id: form_id, class: 'product-form', data-product-form: '' %}
{{ form.errors | default_errors }}
<input type="hidden" name="id" value="{{ current_variant.id }}">
{% if current_variant == blank %}<p class="notice">{{ 'product.unavailable_combination' | t }}</p>{% endif %}
{% if mode == 'buy' %}<div class="purchase-block"><label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" inputmode="numeric" min="{{ current_variant.quantity_rule.min | default: 1 }}"{% if current_variant.quantity_rule.max != blank %} max="{{ current_variant.quantity_rule.max }}"{% endif %} step="{{ current_variant.quantity_rule.increment | default: 1 }}" value="{{ current_variant.quantity_rule.min | default: 1 }}" required>
{% if product.selling_plan_groups.size > 0 %}<label for="Plan-{{ section.id }}">{{ 'product.purchase_option' | t }}</label><select name="selling_plan" id="Plan-{{ section.id }}">{% unless product.requires_selling_plan %}<option value="">{{ 'product.one_time' | t }}</option>{% endunless %}{% for group in product.selling_plan_groups %}<optgroup label="{{ group.name | escape }}">{% for plan in group.selling_plans %}<option value="{{ plan.id }}"{% if product.selected_selling_plan.id == plan.id %} selected{% endif %}>{{ plan.name | escape }}</option>{% endfor %}</optgroup>{% endfor %}</select>{% endif %}
<button class="button full" type="submit" name="add"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}{% render 'icon', name: 'bag' %}</button>
{% if section.settings.show_dynamic_checkout and current_variant.available %}{{ form | payment_button }}{% endif %}
<p class="caption">{% if cart.taxes_included %}{{ 'cart.taxes_included' | t }}{% else %}{{ 'cart.taxes_checkout' | t }}{% endif %}{% if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'cart.shipping_policy' | t }}</a>{% else %} {{ 'cart.shipping_checkout' | t }}{% endif %}</p></div>{% endif %}
<p class="form-error" role="alert" data-product-error hidden></p>
{% endform %}

{% render 'quote-action', product: product, class: 'full secondary' %}
<p class="quote-next caption" data-quote-next hidden>{{ 'quote.added' | t }} <a class="text-link" href="{{ quote_url }}">{{ 'quote.continue' | t }}{% render 'icon', name: 'diagonal' %}</a></p>
<div class="product-support"><p>{{ 'product.team' | t }}</p><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone | escape }}</a><a href="mailto:{{ settings.email | escape }}">{{ settings.email | escape }}</a>{% if product.metafields.kepler.documents.value != blank %}<a href="#Documents-{{ section.id }}">{{ 'product.documents' | t }}{% render 'icon', name: 'diagonal' %}</a>{% endif %}</div>
{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'text' %}<div class="rte product-note" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% when 'accordion' %}<details class="product-detail" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div></details>{% endcase %}{% endfor %}
<details class="product-detail" open><summary>{{ 'product.description' | t }}</summary><div class="rte">{{ product.description }}</div></details>
{% if product.metafields.kepler.specifications.value != blank %}<details class="product-detail" open><summary>{{ 'product.specifications' | t }}</summary><dl class="specifications">{% for spec in product.metafields.kepler.specifications.value %}<div><dt>{{ spec[0] | escape }}</dt><dd>{{ spec[1] | escape }}</dd></div>{% endfor %}</dl></details>{% endif %}
{% if product.metafields.kepler.documents.value != blank %}<details class="product-detail" id="Documents-{{ section.id }}" open><summary>{{ 'product.documents' | t }}</summary><ul class="document-list">{% for document in product.metafields.kepler.documents.value %}<li><a href="{{ document.url | escape }}" target="_blank" rel="noopener">{{ document.label | escape }} {% render 'icon', name: 'diagonal' %}<span class="sr-only">{{ 'accessibility.new_window' | t }}</span></a></li>{% endfor %}</ul></details>{% endif %}
{% if product.metafields.kepler.source_url.value != blank %}<p class="caption"><a href="{{ product.metafields.kepler.source_url.value | escape }}" target="_blank" rel="noopener">{{ 'product.source' | t }}<span class="sr-only">{{ 'accessibility.new_window' | t }}</span></a></p>{% endif %}
</div></div>
<div class="product-mobile-action"><div><span class="mobile-action-model">{{ current_variant.sku | default: product.title | escape }}</span>{% render 'price', product: product, variant: current_variant %}</div>{% if mode == 'buy' %}<button class="button" type="submit" form="{{ form_id }}" name="add"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'product.add_short' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}{% render 'icon', name: 'bag' %}</button>{% else %}{% render 'quote-action', product: product, request_pricing: true %}{% endif %}</div>
</section>
{% if mode == 'buy' %}<script type="application/ld+json">{{ product | structured_data }}</script>{% else %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"url":{{ canonical_url | json }},"brand":{"@type":"Brand","name":{{ product.vendor | json }}},"sku":{{ current_variant.sku | json }}{% if product.featured_image %},"image":{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% endif %}}</script>{% endif %}
{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Accelerated checkout",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Discuss your specification with our Dubai team.</p>"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Collapsible information",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Additional information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    }
  ]
}
{% endschema %}
