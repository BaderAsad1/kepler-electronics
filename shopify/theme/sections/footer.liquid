<footer class="site-footer"><div class="container"><div class="footer-grid"><div>{% render 'brand' %}<p>Intelligence. Built in.</p><address>{{ settings.address | escape }}<br><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone | escape }}</a><br><a href="mailto:{{ settings.email | escape }}">{{ settings.email | escape }}</a></address></div>
{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2>{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div>{% endfor %}
<div><h2>{{ 'general.your_project' | t }}</h2><a href="{{ settings.quote_page.url | default: '/pages/project-quote' }}">{{ 'quote.title' | t }}</a><a href="{{ routes.cart_url }}">{{ 'cart.title' | t }}</a><a href="{{ settings.contact_page.url | default: '/pages/contact' }}">{{ 'general.contact' | t }}</a>
{% if section.settings.show_localization %}{% render 'localization', id: section.id %}{% endif %}</div></div>
<div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><div>{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div><span>{{ section.settings.office_line | escape }}</span></div>
{% if section.settings.show_payments and settings.enable_commerce %}<div class="payment-icons" aria-label="{{ 'cart.payment_methods' | t }}">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{% endfor %}</div>{% endif %}</div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "office_line",
      "label": "Office line",
      "default": "Dubai · Amman · Istanbul"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Country and language selectors",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Accepted payment icons",
      "default": false
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
