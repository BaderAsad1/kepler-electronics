<section class="container section spaces"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}{% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
<div class="spaces-grid">{% for block in section.blocks %}<a class="space-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="space-image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy' }}{% elsif block.settings.scene != 'sourcing' %}{% assign scene_asset = block.settings.scene | append: '-768.webp' %}<img src="{{ scene_asset | asset_url }}" alt="{{ block.settings.title | escape }} — {{ 'images.concept' | t }}" width="768" height="512" loading="lazy">{% else %}<div class="sourcing">{% render 'icon', name: 'layers' %}<p>{{ 'general.precise_technology' | t }}</p></div>{% endif %}<span class="space-number">0{{ forloop.index }}</span><span class="space-arrow">{% render 'icon', name: 'diagonal' %}</span></div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.subtitle | escape }}</p></a>{% endfor %}</div><p class="caption">{{ section.settings.credit | escape }}</p></section>
{% schema %}
{
  "name": "Spaces and solutions",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SPACES WITH POSSIBILITIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What are you creating?"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Heading link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore our solutions"
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Image credit",
      "default": "Architectural images are illustrative concepts."
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "space",
      "name": "Space",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A home or villa"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Everyday living, effortlessly connected."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "scene",
          "label": "Default image",
          "options": [
            {
              "value": "connected-living",
              "label": "Home"
            },
            {
              "value": "hospitality-room-control",
              "label": "Hotel"
            },
            {
              "value": "commercial-building-intelligence",
              "label": "Commercial building"
            },
            {
              "value": "sourcing",
              "label": "Product sourcing"
            }
          ],
          "default": "connected-living"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spaces and solutions"
    }
  ]
}
{% endschema %}
