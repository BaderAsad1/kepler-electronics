<form class="facets" method="get" action="{{ results.url | default: routes.search_url }}">{% if results.terms %}<input type="hidden" name="q" value="{{ results.terms | escape }}"><input type="hidden" name="options[prefix]" value="last">{% endif %}
<label for="Sort-{{ section_id }}">{{ 'catalog.sort' | t }}</label><select id="Sort-{{ section_id }}" name="sort_by">{% assign sort_by = results.sort_by | default: results.default_sort_by %}{% for option in results.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select>
{% for filter in results.filters %}<details class="filter" open><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>{% case filter.type %}{% when 'boolean', 'list' %}<ul>{% for value in filter.values %}<li><label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span>{{ value.label | escape }} ({{ value.count }})</span></label></li>{% endfor %}</ul>{% when 'price_range' %}{% if settings.enable_commerce %}<div class="price-range"><label for="Min-{{ section_id }}-{{ forloop.index }}">{{ 'catalog.min_price' | t }} ({{ cart.currency.iso_code }})</label><input id="Min-{{ section_id }}-{{ forloop.index }}" name="{{ filter.min_value.param_name }}" type="number" inputmode="decimal" min="0" step="any"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}><label for="Max-{{ section_id }}-{{ forloop.index }}">{{ 'catalog.max_price' | t }} ({{ cart.currency.iso_code }})</label><input id="Max-{{ section_id }}-{{ forloop.index }}" name="{{ filter.max_value.param_name }}" type="number" inputmode="decimal" min="0" step="any" max="{{ filter.range_max | divided_by: 100.0 }}"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></div>{% endif %}{% endcase %}</details>{% endfor %}
<button class="button full" type="submit">{{ 'catalog.apply' | t }}</button><a class="text-link" href="{{ results.url | default: routes.search_url }}{% if results.terms %}?q={{ results.terms | url_encode }}{% endif %}">{{ 'catalog.reset' | t }}</a></form>
