{% if cart.item_count == 0 %}<div class="empty-state"><h2>{{ 'cart.empty' | t }}</h2><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.explore_products' | t }}{% render 'icon', name: 'arrow' %}</a></div>{% else %}
{% assign blocked_checkout = false %}<form action="{{ routes.cart_url }}" method="post" class="cart-form" id="CartForm-{{ context }}"><div class="cart-lines">{% for item in cart.items %}{% capture mode %}{% render 'commerce-mode', product: item.product %}{% endcapture %}{% if mode != 'buy' %}{% assign blocked_checkout = true %}{% endif %}<article class="cart-line"><a href="{{ item.url }}" class="cart-image">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '120px', loading: 'lazy', alt: item.product.title }}{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}<span class="sr-only">{{ 'accessibility.new_window' | t }}</span></a>{% else %}{{ property.last | escape }}{% endif %}</p>{% endif %}{% endfor %}
{% if item.error_message != blank %}<p id="CartError-{{ context }}-{{ forloop.index }}" class="form-error" role="alert">{{ item.error_message | escape }}</p>{% endif %}
{% for discount in item.line_level_discount_allocations %}<p class="discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money_with_currency }})</p>{% endfor %}
{% if mode == 'buy' %}<p>{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money_with_currency }}</s> {% endif %}{{ item.final_line_price | money_with_currency }}</p>{% else %}<p class="notice">{{ 'cart.quote_item' | t }}</p>{% endif %}
<label for="CartQty-{{ context }}-{{ forloop.index }}">{{ 'product.quantity' | t }}</label><input id="CartQty-{{ context }}-{{ forloop.index }}" name="updates[{{ item.key }}]" type="number" value="{{ item.quantity }}" min="{{ item.variant.quantity_rule.min | default: 1 }}"{% if item.error_message != blank %} aria-describedby="CartError-{{ context }}-{{ forloop.index }}"{% endif %} step="{{ item.variant.quantity_rule.increment | default: 1 }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %} inputmode="numeric">{% if item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.increment > 1 %}<p class="caption">{{ 'cart.quantity_rule' | t: min: item.variant.quantity_rule.min, increment: item.variant.quantity_rule.increment }}</p>{% endif %}<a class="text-link" href="{{ routes.cart_change_url }}?id={{ item.key | url_encode }}&quantity=0">{{ 'cart.remove' | t }}</a></div></article>{% endfor %}</div>
<details class="cart-note"{% if cart.note != blank %} open{% endif %}><summary>{{ 'cart.note' | t }}</summary><label class="sr-only" for="CartNote-{{ context }}">{{ 'cart.note' | t }}</label><textarea id="CartNote-{{ context }}" name="note" rows="3">{{ cart.note | escape }}</textarea></details><button class="button secondary full" type="submit" name="update">{{ 'cart.update' | t }}</button>
<div class="cart-summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money_with_currency }}</span></p>{% endfor %}<p class="subtotal">{{ 'cart.subtotal' | t }} <strong>{{ cart.total_price | money_with_currency }}</strong></p><p class="caption">{% if cart.taxes_included %}{{ 'cart.taxes_included' | t }}{% else %}{{ 'cart.taxes_checkout' | t }}{% endif %} {{ 'cart.shipping_checkout' | t }}</p>
{% if blocked_checkout %}<p class="notice">{{ 'cart.blocked' | t }}</p><a class="button full" href="{{ settings.quote_page.url | default: '/pages/project-quote' }}">{{ 'quote.title' | t }}</a>{% else %}<button class="button full" type="submit" name="checkout">{{ 'cart.checkout' | t }}{% render 'icon', name: 'arrow' %}</button>{% if context == 'page' and additional_checkout_buttons %}<div class="additional-checkout">{{ content_for_additional_checkout_buttons }}</div>{% endif %}{% endif %}</div></form>{% endif %}
