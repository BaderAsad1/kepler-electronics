{% capture mode %}{% render 'commerce-mode', product: product %}{% endcapture %}
{% if mode == 'buy' %}{% assign allocation = product.selected_selling_plan_allocation %}<div class="price">{% if variant != blank %}{% assign display_price = allocation.price | default: variant.price %}{% assign compare_price = allocation.compare_at_price | default: variant.compare_at_price %}{% if compare_price > display_price %}<s>{{ compare_price | money_with_currency }}</s>{% endif %}<span>{{ display_price | money_with_currency }}</span>{% if variant.unit_price_measurement != blank %}<small>{{ variant.unit_price | money }}/{{ variant.unit_price_measurement.reference_value }}{{ variant.unit_price_measurement.reference_unit }}</small>{% endif %}{% else %}{% if product.price_varies %}{{ 'product.from' | t }} {% endif %}{{ product.price | money_with_currency }}{% endif %}</div>{% else %}<span class="quote-price">{{ 'product.quote_price' | t }}</span>{% endif %}
