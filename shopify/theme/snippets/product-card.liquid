<article class="product-card"><a class="product-image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}<span class="product-arrow">{% render 'icon', name: 'diagonal' %}</span></a><p class="product-vendor">{{ product.vendor | escape }}</p><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% render 'price', product: product %}<a class="text-link" href="{{ product.url }}">{{ 'product.view' | t }}{% render 'icon', name: 'arrow' %}</a></article>
