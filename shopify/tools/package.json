    "export": "node export-catalog.mjs && node export-setup.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@shopify/cli": "4.8.5",
    "liquidjs": "10.24.0"
  }
}
